# ============================================
# Rally Mapper Environment Variables (Example)
# ============================================

# Supabase Project URL (Public)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (Safe for client use)
VITE_SUPABASE_ANON_KEY=

# Sentry DSN for crash reporting (optional — omit to disable)
VITE_SENTRY_DSN=

# Set to "true" to hide self-registration on the sign-in page
VITE_BETA_MODE=